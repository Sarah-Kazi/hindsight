# ── Model (pick ONE provider; the first key found is used unless LLM_PROVIDER is set) ──
# Google Gemini — free tier available at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI — https://platform.openai.com
OPENAI_API_KEY=

# Optional: force a provider (gemini | anthropic | openai) and/or model ids
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash          # main chat model
# LLM_FAST_MODEL=gemini-3.5-flash-lite # background memory digests

# ── Web search (required) — free tier: 1,000 credits/month at https://tavily.com ──
TAVILY_API_KEY=
# basic (1 credit, faster) | advanced (2 credits, better page excerpts)
# SEARCH_DEPTH=advanced

# ── Server ──
# PORT=3000
# DATA_DIR=./data
